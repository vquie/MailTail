MAILTAIL_ADMIN_USERNAME=admin
MAILTAIL_ADMIN_PASSWORD=change-me
# MAILTAIL_ALLOWED_ORIGINS=https://mailtail.example.com
MAILTAIL_SMTP_LOG_VERBOSE=false
MAILTAIL_MAILFAIL_ENABLED=false
# MAILTAIL_MAILFAIL_RULES_FILE=examples/mailfail.yaml

MAILTAIL_ALLOWED_REMOTE_IPS=127.0.0.1,::1

MAILTAIL_ACCEPTED_RCPT_DOMAINS=example.test,internal.test
MAILTAIL_ACCEPTED_FROM_DOMAINS=sender.test

# Regex patterns are also supported, for example:
# MAILTAIL_ACCEPTED_RCPT_DOMAINS=(^|\\.)example\\.test$,^.+@internal\\.test$
# MAILTAIL_ACCEPTED_FROM_DOMAINS=^.+@sender\\.test$

# Optional overrides
# HTTP_ADDR=:8080
# SMTP_ADDR=:8025
# HTTP_PORT=8080
# SMTP_PORT=8025
# DOCKER_CONTAINER=mailtail
# DOCKER_VOLUME=mailtail-data
# DOCKER_IMAGE=mailtail:dev
