{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "config:best-practices",
    "customManagers:makefileVersions",
        "schedule:weekdays",
    ":noUnscheduledUpdates",
    "mergeConfidence:all-badges",
    ":assignee(vquie)"
  ],
  "addLabels": ["{{updateType}}"],
  "semanticCommits": "enabled",
  "separateMajorMinor": true,
  "separateMinorPatch": true,
  "lockFileMaintenance": {
    "automerge": true
  },
  "vulnerabilityAlerts": {
    "addLabels": ["security"]
  },
  "osvVulnerabilityAlerts": true,
  "dependencyDashboard": {
    "osvVulnerabilitySummary": "all"
  },
  "packageRules": [
    {
      "description": "Tidy Go module files after dependency updates",
      "matchManagers": ["gomod"],
      "postUpdateOptions": ["gomodTidy"]
    },
    {
      "description": "Auto-merge low-risk patch, pin, and digest updates after CI",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "minimumReleaseAge": "3 days",
      "internalChecksFilter": "strict",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Auto-merge minor updates after a longer stability window",
      "matchUpdateTypes": ["minor"],
      "minimumReleaseAge": "7 days",
      "internalChecksFilter": "strict",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Never auto-merge major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Keep the MegaLinter Makefile version on a floating major tag",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "matchFileNames": ["Makefile"],
      "matchPackageNames": ["ghcr.io/oxsecurity/megalinter"],
      "allowedVersions": "/^v[0-9]+$/",
      "pinDigests": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update digest-pinned Docker images in Makefiles",
      "managerFilePatterns": ["/(^|/)Makefile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?\\s+[A-Za-z0-9_]+?_IMAGE\\s*:*\\??=\\s*[^\\s:]+:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ]
    }
  ]
}
